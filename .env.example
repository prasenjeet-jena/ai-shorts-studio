# ==============================================================================
# AI Shorts Generator - Local Configuration
# ==============================================================================
# All processing runs locally on-device. No paid APIs or cloud accounts needed.
# Copy this file to '.env' to override default configuration values.

# --- Faster-Whisper Settings ---
# Available models: tiny.en, base.en, small.en, medium.en, large-v3
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32

# --- Custom Binary Paths (Optional) ---
# If ffmpeg, ffprobe, or node are not in standard PATH or Homebrew locations,
# specify their explicit paths here:
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# NODE_PATH=/opt/homebrew/bin/node
